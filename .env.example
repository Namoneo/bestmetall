# Copy to .env (or set in cPanel) and fill in real values.
SECRET_KEY=replace-this-with-a-long-random-string
JWT_SECRET=replace-this-too
ADMIN_EMAIL=admin@bestmetall.uz
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated origins allowed to call the API from a different host.
# Leave empty when the Flask app also serves the website (same origin).
CMS_ALLOWED_ORIGINS=

# Telegram lead delivery (same bot used by the contact form).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
